<?xml version="1.0" encoding="UTF-8"?>
<CONFIG>
  <ProjectOptions>
    <Version Value="12"/>
    <PathDelim Value="/"/>
    <General>
      <SessionStorage Value="InProjectDir"/>
      <Title Value="TWX Proxy"/>
      <Scaled Value="True"/>
      <ResourceType Value="res"/>
      <UseXPManifest Value="True"/>
      <XPManifest>
        <DpiAware Value="True"/>
        <TextName Value="TWXProxy"/>
        <TextDesc Value="Trade Wars X Proxy Server"/>
      </XPManifest>
      <Icon Value="0"/>
    </General>
    <i18n>
      <EnableI18N LFM="False"/>
    </i18n>
    <BuildModes>
      <Item Name="Default" Default="True"/>
      <Item Name="Debug">
        <CompilerOptions>
          <Version Value="11"/>
          <PathDelim Value="/"/>
        <CustomOptions Value="-dLCL -dLCLgtk2"/>
          <Target>
            <Filename Value="TWXP"/>
          </Target>
          <SearchPaths>
            <IncludeFiles Value="$(ProjOutDir);/usr/share/lazarus/4.2.0/lcl/include"/>
            <OtherUnitFiles Value="../../source/forms;../../source/core;../../source/utils;../../source/libs/synapse;../../source;/usr/share/lazarus/4.2.0/lcl;/usr/share/lazarus/4.2.0/lcl/interfaces/gtk2;/usr/share/lazarus/4.2.0/lcl/widgetset;/usr/share/lazarus/4.2.0/lcl/forms;/usr/share/lazarus/4.2.0/lcl/units/x86_64-linux;/usr/share/lazarus/4.2.0/components/lazutils/lib/x86_64-linux"/>
            <UnitOutputDirectory Value="lib/$(TargetCPU)-$(TargetOS)"/>
          </SearchPaths>
          <Parsing>
            <SyntaxOptions>
              <IncludeAssertionCode Value="True"/>
            </SyntaxOptions>
          </Parsing>
          <CodeGeneration>
            <Checks>
              <IOChecks Value="True"/>
              <RangeChecks Value="True"/>
              <OverflowChecks Value="True"/>
              <StackChecks Value="True"/>
            </Checks>
            <VerifyObjMethodCallValidity Value="True"/>
          </CodeGeneration>
          <Linking>
            <Debugging>
              <DebugInfoType Value="dsDwarf3"/>
              <UseHeaptrc Value="True"/>
              <TrashVariables Value="True"/>
              <UseExternalDbgSyms Value="True"/>
            </Debugging>
          </Linking>
        </CompilerOptions>
      </Item>
      <Item Name="Release">
        <CompilerOptions>
          <Version Value="11"/>
          <PathDelim Value="/"/>
        <CustomOptions Value="-dLCL -dLCLgtk2"/>
          <Target>
            <Filename Value="TWXP"/>
          </Target>
          <SearchPaths>
            <IncludeFiles Value="$(ProjOutDir);/usr/share/lazarus/4.2.0/lcl/include"/>
            <OtherUnitFiles Value="../../source/forms;../../source/core;../../source/utils;../../source/libs/synapse;../../source;/usr/share/lazarus/4.2.0/lcl;/usr/share/lazarus/4.2.0/lcl/interfaces/gtk2;/usr/share/lazarus/4.2.0/lcl/widgetset;/usr/share/lazarus/4.2.0/lcl/forms;/usr/share/lazarus/4.2.0/lcl/units/x86_64-linux;/usr/share/lazarus/4.2.0/components/lazutils/lib/x86_64-linux"/>
            <UnitOutputDirectory Value="lib/$(TargetCPU)-$(TargetOS)"/>
          </SearchPaths>
          <CodeGeneration>
            <SmartLinkUnit Value="True"/>
            <Optimizations>
              <OptimizationLevel Value="3"/>
            </Optimizations>
          </CodeGeneration>
          <Linking>
            <Debugging>
              <GenerateDebugInfo Value="False"/>
            </Debugging>
            <LinkSmart Value="True"/>
          </Linking>
        </CompilerOptions>
      </Item>
    </BuildModes>
    <PublishOptions>
      <Version Value="2"/>
      <UseFileFilters Value="True"/>
    </PublishOptions>
    <RunParams>
      <FormatVersion Value="2"/>
      <Modes>
        <Mode Name="default"/>
      </Modes>
    </RunParams>
    <RequiredPackages>
      <Item Name="LCL"/>
    </RequiredPackages>
    <Units>
      <Unit>
        <Filename Value="TWXP.lpr"/>
        <IsPartOfProject Value="True"/>
      </Unit>
    </Units>
  </ProjectOptions>
  <CompilerOptions>
    <Version Value="11"/>
    <PathDelim Value="/"/>
    <Target>
      <Filename Value="TWXP"/>
    </Target>
    <SearchPaths>
      <IncludeFiles Value="$(ProjOutDir);/usr/share/lazarus/4.2.0/lcl/include"/>
      <OtherUnitFiles Value="../../source/forms;../../source/core;../../source/utils;../../source/libs/synapse;../../source;/usr/share/lazarus/4.2.0/lcl;/usr/share/lazarus/4.2.0/lcl/interfaces/gtk2;/usr/share/lazarus/4.2.0/lcl/widgetset;/usr/share/lazarus/4.2.0/lcl/forms;/usr/share/lazarus/4.2.0/lcl/units/x86_64-linux;/usr/share/lazarus/4.2.0/components/lazutils/lib/x86_64-linux"/>
      <UnitOutputDirectory Value="lib/$(TargetCPU)-$(TargetOS)"/>
    </SearchPaths>
    <Linking>
      <Debugging>
        <DebugInfoType Value="dsDwarf3"/>
      </Debugging>
    </Linking>
  </CompilerOptions>
  <Debugging>
    <Exceptions>
      <Item Name="EAbort"/>
      <Item Name="ECodetoolError"/>
      <Item Name="EFOpenError"/>
    </Exceptions>
  </Debugging>
</CONFIG>